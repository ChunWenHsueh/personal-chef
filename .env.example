# S3 bucket and its AWS region
S3_BUCKET=your-bucket-name
AWS_DEFAULT_REGION=us-east-1

# Optional when credentials come from an AWS profile or IAM role.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=your-session-token

# GET /oss/presign?filename=photo.jpg returns one-hour PUT and GET URLs.
# Upload the raw file using PUT with Content-Type set to contentType.
# The signing identity needs s3:PutObject and s3:GetObject for the object.
