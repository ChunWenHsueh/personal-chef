# Model and recipe search
DEEPSEEK_API_KEY=your-deepseek-api-key
TAVILY_API_KEY=your-tavily-api-key

# S3 bucket and its AWS region
S3_BUCKET=your-bucket-name
AWS_DEFAULT_REGION=us-east-1
AWS_PROFILE=chef-local

# To use environment credentials instead, remove AWS_PROFILE and set:
# AWS_ACCESS_KEY_ID=your-access-key-id
# AWS_SECRET_ACCESS_KEY=your-secret-access-key
# AWS_SESSION_TOKEN=your-session-token

# Credentials need s3:PutObject and s3:GetObject on this bucket's objects.
